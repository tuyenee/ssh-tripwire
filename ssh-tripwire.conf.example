# Copy to /etc/ssh-tripwire.conf and fill in ONE OR MORE destinations.
# Reminder: root (the admin) can read this file. Only ever put WRITE-ONLY /
# append-only credentials here — nothing that can delete or rewrite remote data.

# Public key used to encrypt every event before shipping (hybrid RSA+AES).
# ONLY the public key belongs on this machine. Keep the private key off-device.
PUBKEY="/etc/ssh-tripwire-public.pem"

# Option A: ntfy topic (pick a long random name; anyone who knows it can read/post)
NTFY_URL="https://ntfy.sh/ssh-tripwire-CHANGE-ME-to-something-random-9f3a2c"

# Option B: remote syslog collector you control
# SYSLOG_HOST="logs.example.com"
# SYSLOG_PORT="514"

# Option C: append-only S3 bucket with Object Lock, key limited to s3:PutObject
# S3_BUCKET="my-ssh-audit-bucket"
# (configure the aws CLI with a PutObject-only IAM user separately)
